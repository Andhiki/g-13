# Copy to `.env` beside wrangler.jsonc for local development.
# In production, configure secrets with `wrangler secret put`.
# Do not also create `.dev.vars`: Cloudflare would ignore `.env`.
# Never commit real values.

# Strapi API token with read-only access to the `Alumni` collection.
# The token is only read by the server route in src/routes/api/alumni.ts.
STRAPI_API_TOKEN=

# Optional: override the Strapi origin. Defaults to https://strapi.kagamailkomp.id
STRAPI_ORIGIN=

# Required for review submissions and likes: generate a random value of 32+ characters.
# Example command: openssl rand -hex 32
REVIEW_RATE_LIMIT_SECRET=
