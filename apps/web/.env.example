STRAPI_API_TOKEN=

# Optional; defaults to https://strapi.kagamailkomp.id
STRAPI_ORIGIN=

# 32+ characters; generate with: openssl rand -hex 32
REVIEW_RATE_LIMIT_SECRET=

# Server-only; 32+ random characters. Never commit actual credentials.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare Turnstile (invisible) for anonymous lecturer reviews. Both keys come
# from the same widget. Fail-closed: reviews are rejected when TURNSTILE_SECRET_KEY
# is empty. See docs/lecturer-reviews.md. Dummy test keys work on localhost.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=