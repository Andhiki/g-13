{
  "name": "@g13/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "preview": "vite preview",
    "deploy": "cf deploy --prebuilt",
    "deploy:staging": "cf deploy --prebuilt --mode staging --force",
    "typecheck": "bun check --no-script",
    "lint": "oxlint --deny-warnings src scripts vite.config.ts",
    "lint:fix": "oxlint --fix src scripts vite.config.ts",
    "format": "bun fmt src scripts vite.config.ts package.json tsconfig.json",
    "format:check": "bun fmt --check src scripts vite.config.ts package.json tsconfig.json",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "test": "bun test --preload ./src/test/setup.ts src scripts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
