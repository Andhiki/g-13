    "@unpic/react": "^1.0.2",
    "@xyflow/react": "^12.12.0",
    "better-auth": "1.7.25",
    "cn": "^0.5.2",
    "i18next": "^26.5.11",
    "indonesian-badwords": "2.7.0",
    "merge-refs": "^2.0.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
