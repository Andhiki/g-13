{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".wrangler/deploy/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "fmt:check": {},
    "fmt": {
      "cache": false
    },
    "lint:fix": {
      "cache": false
    },
    "@g13/curriculum#test": {
      "dependsOn": ["build"]
    },
    "@g13/curriculum#typecheck": {
      "dependsOn": ["build"]
    }
  },
  "globalDependencies": [".oxfmtrc.json"]
}
