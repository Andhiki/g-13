{
  "name": "@g13/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "bun --bun tsdown",
    "db:export": "drizzle-kit export --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "typecheck": "bun check --no-script",
    "lint": "oxlint --deny-warnings src tsdown.config.ts drizzle.config.ts",
    "lint:fix": "oxlint --fix src tsdown.config.ts drizzle.config.ts",
    "fmt": "oxfmt src tsdown.config.ts drizzle.config.ts package.json tsconfig.json",
    "fmt:check": "oxfmt --check src tsdown.config.ts drizzle.config.ts package.json tsconfig.json"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "drizzle-kit": "0.31.11",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2"
  }
}
