        },
        "theses_author_batch_range": {
          "name": "theses_author_batch_range",
          "value": "\"theses\".\"author_batch\" is null or \"theses\".\"author_batch\" between 1945 and 2100"
        },
        "theses_type_valid": {
          "name": "theses_type_valid",
          "value": "\"theses\".\"type\" in ('skripsi', 'product-innovation', 'collaborative-project', 'industry-project', 'scientific-publication')"
        },
        "theses_language_valid": {
          "name": "theses_language_valid",
          "value": "\"theses\".\"language\" in ('id', 'en')"
        },
        "theses_status_valid": {
          "name": "theses_status_valid",
          "value": "\"theses\".\"status\" in ('draft', 'published', 'hidden')"
        },
        "theses_contact_channel_valid": {
          "name": "theses_contact_channel_valid",
          "value": "\"theses\".\"contact_channel\" is null or \"theses\".\"contact_channel\" in ('email', 'url')"
        },
        "theses_abstract_public_content": {
          "name": "theses_abstract_public_content",
          "value": "\"theses\".\"abstract_public\" = 0 or (\"theses\".\"abstract\" is not null and length(trim(\"theses\".\"abstract\")) > 0)"
        },
        "theses_contact_public_content": {
          "name": "theses_contact_public_content",
          "value": "\"theses\".\"contact_public\" = 0 or (\"theses\".\"contact_channel\" is not null and \"theses\".\"contact_value\" is not null and length(trim(\"theses\".\"contact_value\")) > 0)"
        },
        "theses_consent_required": {
          "name": "theses_consent_required",
          "value": "(\"theses\".\"abstract_public\" = 0 and \"theses\".\"contact_public\" = 0) or \"theses\".\"consent_at\" is not null"
        },
        "theses_published_consent": {
          "name": "theses_published_consent",
          "value": "\"theses\".\"status\" != 'published' or (\"theses\".\"consent_at\" is not null and \"theses\".\"consent_source\" is not null)"
        }
      }
    },
