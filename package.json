{
  "name": "g-13-kurikulum-ilkom-ugm",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter='./apps/*'",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build": "turbo run build",
    "preview": "bun run --cwd apps/web preview",
    "deploy": "bun run --cwd apps/web deploy",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fmt": "turbo run fmt",
    "fmt:check": "turbo run fmt:check",
    "check": "turbo run lint fmt:check typecheck test",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  },
  "packageManager": "bun@1.4.3"
}
