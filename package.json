{
  "name": "g-13-kurikulum-ilkom-ugm",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter='./apps/*'",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build": "turbo run build",
    "preview": "bun run --cwd apps/web preview",
    "deploy": "bun run --cwd apps/web deploy",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate:local": "cf d1 migrations apply 00000000-0000-4000-8000-000000000001 --local --dir packages/db/migrations --persist-to apps/web/.cloudflare/state",
    "db:migrate:remote": "cf d1 migrations apply 00000000-0000-4000-8000-000000000001 --dir packages/db/migrations",
    "db:seed": "cf d1 query 00000000-0000-4000-8000-000000000001 --local --persist-to apps/web/.cloudflare/state --sql \"$(cat packages/db/seed.sql)\"",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fmt": "turbo run fmt",
    "fmt:check": "turbo run fmt:check",
    "check": "turbo run lint fmt:check typecheck test",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  },
  "packageManager": "bun@1.4.4"
}
